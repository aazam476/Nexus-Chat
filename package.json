{
  "name": "nexus-chat",
  "private": true,
  "description": "Nexus Chat monorepo: JavaScript and TypeScript workspaces. Go code lives in apps/server and apps/push-relay.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "build": "turbo run build",
    "generate": "turbo run generate",
    "lint": "turbo run lint && prettier --check .",
    "format": "prettier --write .",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "licenses": "scripts/check-licenses.sh js ."
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.30.1",
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-jsdoc": "65.4.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-native-a11y": "3.5.1",
    "eslint-plugin-tsdoc": "0.5.4",
    "globals": "17.14.0",
    "license-checker-rseidelsohn": "5.0.1",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
