# Nexus Chat configuration. Copy this file to .env and set the two
# required values. Everything else can be changed later in the Admin panel.

# Required
ADMIN_EMAIL=admin@example.com
POSTGRES_PASSWORD=change-me

# Optional
# Public domain, e.g. chat.example.com. Can instead be set in the setup
# wizard. Needed before enabling HTTPS, federation, the official push relay,
# or invite links for people outside your network.
DOMAIN=
# Ports on this machine.
HTTP_PORT=8080
HTTPS_PORT=8443
# Set this when using a reverse proxy, e.g. 172.16.0.0/12 for Docker's
# default networks. Only these addresses may set X-Forwarded-For/-Proto.
TRUSTED_PROXIES=
# Where data is kept on this machine. Back up this folder.
DATA_DIR=./data
