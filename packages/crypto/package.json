{
  "name": "@nexus-chat/crypto",
  "version": "0.0.0",
  "private": true,
  "description": "End-to-end encryption for Nexus Chat: MLS groups, device keys, key backup and attachment encryption (spec \u00a75).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --coverage",
    "bench": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --roots bench --testRegex \"\\.bench\\.ts$\" --coverage=false --testTimeout=3600000",
    "mutation": "stryker run"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/bip39": "2.4.0",
    "libsodium-wrappers-sumo": "0.8.4",
    "ts-mls": "1.6.4"
  },
  "devDependencies": {
    "@hpke/chacha20poly1305": "1.8.1",
    "@hpke/dhkem-x448": "1.8.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/jest-runner": "10.1.1",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "fast-check": "4.10.2",
    "jest": "30.5.2",
    "ts-jest": "29.4.15"
  }
}
