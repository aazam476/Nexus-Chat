{
  "name": "@nexus-chat/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript client for the Nexus Chat server API, generated from apps/server/api/openapi.yaml.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "openapi-ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --coverage"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@types/jest": "30.0.0",
    "jest": "30.5.2",
    "ts-jest": "29.4.15"
  }
}
